# Copier ce fichier en .streamlit/secrets.toml (en local)
# ou coller son contenu dans Streamlit Cloud > App > Settings > Secrets.
# Ne JAMAIS publier le vrai fichier secrets.toml sur GitHub.

# Base Supabase (chaîne « Session pooler » de Supabase > Connect).
# Sans cette ligne, l'application utilise une base SQLite locale.
DATABASE_URL = "postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Assistant IA (clé créée sur https://aistudio.google.com)
GEMINI_API_KEY = "votre-cle-api"
GEMINI_MODEL = "gemini-2.5-flash"

# Mot de passe des comptes de démonstration, appliqué au PREMIER lancement uniquement
DEMO_PASSWORD = "Ciat2026!"

# Afficher la liste des comptes de démonstration sur la page de connexion (oui / non)
SHOW_DEMO_ACCOUNTS = "oui"

# Optionnel : figer la date utilisée pour calculer les retards (sinon : aujourd'hui)
# DATE_REFERENCE = "2026-10-25"
